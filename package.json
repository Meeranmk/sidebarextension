{
  "name": "vscode-chatbot-extension",
  "publisher": "meeranmohideen",
  "displayName": "Chatbot Sidebar",
  "description": "A VS Code extension with a React-based chatbot in the sidebar",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chatbotSidebar",
          "title": "Sysco Build Assist",
          "icon": "media/checklist.svg"
        }
      ]
    },
    "views": {
      "chatbotSidebar": [
        {
          "id": "chatbotSidebar.chatbotView",
          "name": "Sysco Build Assist",
          "type": "webview",
          "icon": "media/checklist.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./ && vite build --config src/webview/vite.config.ts",
    "watch": "tsc -watch -p ./ & vite build --watch --config src/webview/vite.config.ts",
    "package": "vsce package",
    "publish": "vsce publish",
    "test": "mocha -r ts-node/register src/test/**/*.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^18.11.18",
    "@types/vscode": "^1.95.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "mocha": "^10.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.4",
    "vite": "^5.0.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "@types/react": "^19.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.2.0"
  }
}
